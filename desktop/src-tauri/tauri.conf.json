{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Visualizer",
  "version": "0.9.8",
  "identifier": "com.polysok.code-visualizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Code Visualizer",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cviz"
    ],
    "resources": {
      "grammars/": "grammars/"
    }
  }
}
